# Wallet seed phrase (REQUIRED - keep secret, never commit the real one)
# Required: supply your own private BIP-39 mnemonic. There is no default seed.
CDK_MNEMONIC=""

# Public URL for NUT-18 payment request transport (optional)
# When set, GET /api/pr will include an HTTP POST transport pointing to {BASE_URL}/api/donate
# BASE_URL=https://your-domain.com

# Display name shown in the UI header (optional, defaults to "Cashu Mint Auditor")
# APP_NAME="Cashu Mint Auditor"

# Listen address (optional, defaults to 127.0.0.1:3000; Docker sets 0.0.0.0:3000)
# SITE_ADDR=127.0.0.1:3000

# --- Auditing engine (all optional, defaults shown) -------------------------
# One random swap is audited per round (Python-reference behavior).
# Delay range between swap rounds, in seconds
# AUDITOR_MIN_DELAY_SECS=300
# AUDITOR_MAX_DELAY_SECS=900

# Swap amount range, in sats
# AUDITOR_MIN_AMOUNT=5
# AUDITOR_MAX_AMOUNT=100

# Extra sats a mint may receive above its donation cap (liveness valve).
# 0 = strict balance < sum_donations cap (Python reference).
# AUDITOR_RECEIVE_OVERSHOOT_SATS=0

# Reject melt quotes whose fee reserve exceeds this percentage of the amount
# AUDITOR_MAX_FEE_PERCENT=2.0
# Absolute fee tolerance (sats) before the percent check applies
# AUDITOR_FEE_TOLERANCE_SATS=10

# How long failing mints are benched before being retried, in seconds
# AUDITOR_ERROR_COOLDOWN_SECS=1800

# Dedicated error-retry loop interval, in seconds. 0 disables it (default):
# the Python reference has no second audit path.
# AUDITOR_ERROR_RETRY_INTERVAL_SECS=0

# No-fee NUT-06 availability checks. Values below 3600 are clamped to 3600.
# AUDITOR_HEALTH_CHECK_INTERVAL_SECS=3600
# Consecutive failed checks required before marking a mint failing.
# AUDITOR_HEALTH_FAILURE_THRESHOLD=2

# Balance snapshot interval, in seconds
# AUDITOR_SNAPSHOT_INTERVAL_SECS=3600

# --- Network timeouts (all optional, defaults shown) ------------------------
# Deadline for a value-moving mint call (quote, melt, mint), in seconds.
# Bounds every outbound request so one dead mint can't stall a loop.
# AUDITOR_NET_REQUEST_TIMEOUT_SECS=30
# Deadline for a lightweight mint-info / health probe, in seconds
# AUDITOR_NET_PROBE_TIMEOUT_SECS=10
# Attempts for an idempotent read before giving up (1 = no retry)
# AUDITOR_NET_MAX_ATTEMPTS=3
# Base backoff between retry attempts, in milliseconds (grows per attempt)
# AUDITOR_NET_RETRY_BACKOFF_MS=400

# Log level filter
# RUST_LOG=info
