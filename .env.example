# Optional host port for Docker Compose.
IMF_PORT=3000

# Docker Compose reads this file after you copy it to .env.
# Direct cargo runs use exported environment variables; they do not load .env.
BASE_URL=http://localhost:3000
IMF_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.cashumints.space,wss://relay.nostr.net
RUST_LOG=info
# Direct cargo runs only (the image uses /data):
IMF_DATA_DIR=./data
SITE_ADDR=127.0.0.1:3000
