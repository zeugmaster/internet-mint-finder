    "typographyMeta": {
      "headline": {
        "displayName": "Headline",
        "purpose": "One page title per page; 22px under 760px."
      },
      "figure": {
        "displayName": "Figure",
        "purpose": "KPI and uptime values; 20px under 760px. Units at 15px regular, muted."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Section heads, card and step titles, mint names. Weight alone separates it from body."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Running text; 70 to 75ch caps on subtitles and explainers."
      },
      "table": {
        "displayName": "Table",
        "purpose": "Data table cells."
      },
      "small": {
        "displayName": "Small",
        "purpose": "Metadata, hints, table headers, footer, small buttons, segmented options."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Category chips, tooltips, chart axes, stacked-table labels."
      },
      "stamp": {
        "displayName": "Stamp",
        "purpose": "Hallmark labels only."
      }
    },
    "fonts": [
      {
