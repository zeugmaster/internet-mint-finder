    "themes": {
      "light": {
        "selector": ":root",
        "note": "Default when the visitor's system is light."
      },
      "dark": {
        "selector": ":root[data-theme='dark']",
        "note": "Set before first paint from localStorage or prefers-color-scheme (src/app.rs THEME_SCRIPT); toggled by the header's sun/moon [data-theme-toggle] icon button, which public/dashboard.html repeats. public/dashboard.html mirrors the tokens with opaque Radix steps (--bg, --surface, --ink, --muted, --faint, --rule, --ok, --warn, --error, --info) that the Plotly script reads."
      }
    },
    "typographyMeta": {
      "headline": {
        "displayName": "Headline",
        "purpose": "One page title per page (heading-4); 24px/32px under 760px."
      },
      "title": {
        "displayName": "Title",
        "purpose": "Section heads, card, step and empty-state titles."
      },
      "body": {
        "displayName": "Body",
        "purpose": "Running text; 62ch subtitles and footer notes, 75ch explainers."
      },
      "small": {
        "displayName": "Small",
        "purpose": "Buttons, tabs, fields, table cells, meta lines, hints, header status."
      },
      "label": {
        "displayName": "Label",
        "purpose": "Table headers, badges, tooltips, stat labels, axis ticks."
      },
      "figure": {
        "displayName": "Figure",
        "purpose": "Uptime value; stat-chip values use TX-02 700 at 15/24."
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "URLs, routes, amounts, incident messages; 12/16 for payment requests and error text."
      },
      "stamp": {
        "displayName": "Stamp",
        "purpose": "Hallmark letters only."
      }
    },
    "fonts": [
      {
        "family": "InterVariable",
        "files": [
          "/fonts/InterVariable.woff2",
          "/fonts/InterVariable-Italic.woff2"
        ],
        "weights": "100 900",
        "display": "swap",
        "featureSettings": "'ss03', set on html. All interface text."
      },
      {
        "family": "TX-02",
        "files": [
          "/fonts/tx-02-regular.otf",
          "/fonts/tx-02-italic.otf",
          "/fonts/tx-02-bold.otf",
          "/fonts/tx-02-bold-italic.otf"
        ],
        "weights": [
          400,
          700
        ],
        "display": "swap",
        "featureSettings": "'ss02' (plain undotted zero) plus tabular-nums, on every mono run. Berkeley Mono's successor from the same foundry; licensed, self-hosted, not in git. The crossed seven cannot be turned off; no OpenType feature exposes a plain seven."
      }
    ],
    "shadows": [
      {
        "name": "shadow-default",
        "value": "0 0 0 0.5px #0000 inset, 0 0 0 0.5px #0000000f, 0 1px 1px -1px #0000001a, 0 1px 2px 0 #0000000d",
        "dark": "0 0 0 0.5px #ffffff12 inset",
        "purpose": "The plain hairline ring; the QR frame. Panels, controls and fields use the s-* edges below, which carry the same ring."
      },
      {
        "name": "s-panel",
        "value": "inset 0 -1px 0 #00000008, 0 0 0 0.5px #00000014",
        "dark": "inset 0 1px 0 #ffffff0f, inset 0 0 0 1px #ffffff1a",
        "purpose": "Raised panels (cards, step cards): a firmer ring and a faint shaded bottom edge in light, a lit top edge in dark."
      },
      {
        "name": "s-raised",
        "value": "inset 0 1px 0 #ffffffcc, inset 0 -1px 0 #00000014, 0 0 0 0.5px #00000017",
        "dark": "inset 0 1px 0 #ffffff14, inset 0 0 0 1px #ffffff1a",
        "purpose": "Raised controls (secondary buttons, selects): a white top lip and shaded bottom lip in light, a lit top edge in dark. s-lip is the same without the ring (buttons in the reviews card)."
      },
      {
        "name": "s-well",
        "value": "inset 0 1px 2px #00000014, 0 0 0 0.5px #00000017",
        "dark": "inset 0 1px 1.5px #00000059, inset 0 -1px 0 #ffffff0a, inset 0 0 0 1px #ffffff1a",
        "purpose": "Pressed-in fields: a soft shade under the top edge. s-track is the same without the ring, for tab tracks."
      },
      {
        "name": "s-inverted",
        "value": "inset 0 1px 0 #ffffff29",
        "dark": "inset 0 -1px 0 #00000033",
        "purpose": "Primary button: a lit top edge on black, a shaded foot on white."
      },
      {
        "name": "shadow-large",
        "value": "0 0 0 0.5px #0000000f, 0 2px 3px -2px #0000000f, 0 3px 12px -4px #0000001a, 0 4px 16px -8px #0000000d",
        "dark": "0 0 0 1px #ffffff2c, 0 2px 3px -2px #00000026, 0 3px 8px -2px #00000066, 0 4px 12px -4px #00000080",
        "purpose": "Overlays only (dashboard dropdowns)."
      },
      {
        "name": "focus-ring",
        "value": "inset 0 0 0 0.5px var(--focus), 0 0 0 1px var(--focus)",
        "purpose": "Field focus, stacked on the field's own edges. Elsewhere a 1px outline at -1px offset."
      },
      {
        "name": "tab-edge",
        "value": "inset 0 0 0 1px var(--tab-border)",
        "purpose": "Active segmented tab; in dark a lit 1px top edge is stacked on it."
      },
      {
        "name": "stamp-edge",
        "value": "inset 0 0 0 1px var(--border)",
        "purpose": "Outline (no-verdict) hallmark."
      },
      {
        "name": "danger-hairline",
        "value": "inset 0 0 0 0.5px var(--danger-border)",
        "purpose": "Incident panel, error callout, field error."
      }
    ],
    "motion": [
      {
        "name": "ease",
        "value": "cubic-bezier(0.4, 0, 0.2, 1)",
        "purpose": "150ms colour/background on links, rows, fields; 200ms tooltip fade and chevron."
      },
      {
        "name": "ease-out",
        "value": "cubic-bezier(0, 0, 0.2, 1)",
        "purpose": "150ms button colour and background."
      },
      {
        "name": "tabs",
        "value": "200ms ease-in-out",
        "purpose": "Segmented tab colour, background and edge."
      },
      {
        "name": "tooltip-in",
        "value": "opacity + translate 4px, scale 0.95 to 1, 200ms",
        "purpose": "Hallmark tooltip entrance."
      },
      {
        "name": "skeleton-pulse",
        "value": "pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite (opacity 1 to 0.5)",
        "purpose": "Loading placeholders."
      },
      {
        "name": "reduced-motion",
        "value": "animation and transition none",
        "purpose": "prefers-reduced-motion: reduce."
      }
    ],
