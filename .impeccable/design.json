    "rootCss": ":host{--shell:#f6f6f6;--container:#ffffff;--surface:#ffffff;--surface-strong:#ffffff;--surface-strong-hover:#f9f9f9;--component:#0000000f;--component-hover:#00000017;--component-active:#0000001f;--fg:#000000df;--fg-2:#0000009b;--fg-3:#00000072;--fg-disabled:#00000044;--border:#0000000f;--border-strong:#00000026;--tab-border:#d9d9d9;--focus:#0084e6a1;--brand:#0090ff;--brand-subtle:#008ff519;--on-brand-subtle:#0090ff;--inverted:#000000f2;--inverted-hover:#000000cc;--inverted-active:#000000b3;--on-inverted:#ffffff;--success-bg:#00a43319;--success-fg:#00713fde;--warning-bg:#ff9c0029;--warning-fg:#cc4e00;--danger-bg:#f52b0018;--danger-fg:#cd2200ea;--danger-subtle:#ff200008;--danger-border:#ff35002c;--ok-solid:#30a46c;--warn-solid:#f76b15;--err-solid:#e54d2e;--s-default:0 0 0 0.5px #0000 inset,0 0 0 0.5px #0000000f,0 1px 1px -1px #0000001a,0 1px 2px 0 #0000000d;--focus-ring:inset 0 0 0 0.5px var(--focus),0 0 0 1px var(--focus);--font-sans:'InterVariable',system-ui,-apple-system,'Segoe UI',sans-serif;--font-mono:'TX-02',ui-monospace,'SF Mono',Menlo,monospace;--ease:cubic-bezier(0.4,0,0.2,1);--ease-out:cubic-bezier(0,0,0.2,1);font-family:var(--font-sans);font-feature-settings:'ss03';font-size:15px;line-height:24px;color:var(--fg);background:var(--container);--sheen-panel:linear-gradient(#0000 0,#00000006 160px);--sheen-raised:linear-gradient(#0000,#00000010);--sheen-well:linear-gradient(#00000010,#0000 14px);--sheen-inverted:linear-gradient(#ffffff24,#fff0);--s-panel:inset 0 -1px 0 #00000008,0 0 0 0.5px #00000014;--s-lip:inset 0 1px 0 #ffffffcc,inset 0 -1px 0 #00000014;--s-raised:inset 0 1px 0 #ffffffcc,inset 0 -1px 0 #00000014,0 0 0 0.5px #00000017;--s-well:inset 0 1px 2px #00000014,0 0 0 0.5px #00000017;--s-track:inset 0 1px 2px #00000017;--s-inverted:inset 0 1px 0 #ffffff29;}",
