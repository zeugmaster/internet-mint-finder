  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Inverted fill: near-black in light, near-white in dark. The one main action per view.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Donate ecash</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:0;border-radius:8px;background-color:var(--surface-strong);background-image:var(--sheen-raised);box-shadow:var(--s-raised);color:var(--fg);font-family:var(--font-sans);font-feature-settings:'ss03';font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:color 150ms var(--ease-out),background-color 150ms var(--ease-out)}.ds-btn:hover{background-color:var(--surface-strong-hover)}.ds-btn:focus-visible{outline:1px solid var(--focus);outline-offset:-1px}.ds-btn-primary{background-color:var(--inverted);background-image:var(--sheen-inverted);box-shadow:var(--s-inverted);color:var(--on-inverted)}.ds-btn-primary:hover{background-color:var(--inverted-hover)}.ds-btn-primary:active{background-color:var(--inverted-active)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default .btn: strong surface with the hairline shadow. Retry, clear, sign in.",
      "html": "<button class=\"ds-btn\">Try again</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:0;border-radius:8px;background-color:var(--surface-strong);background-image:var(--sheen-raised);box-shadow:var(--s-raised);color:var(--fg);font-family:var(--font-sans);font-feature-settings:'ss03';font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:color 150ms var(--ease-out),background-color 150ms var(--ease-out)}.ds-btn:hover{background-color:var(--surface-strong-hover)}.ds-btn:focus-visible{outline:1px solid var(--focus);outline-offset:-1px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Transparent; fills grey on hover. Pagination and quiet actions.",
      "html": "<button class=\"ds-btn ds-btn-ghost\">Next</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border:0;border-radius:8px;background-color:var(--surface-strong);background-image:var(--sheen-raised);box-shadow:var(--s-raised);color:var(--fg);font-family:var(--font-sans);font-feature-settings:'ss03';font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:color 150ms var(--ease-out),background-color 150ms var(--ease-out)}.ds-btn:hover{background-color:var(--surface-strong-hover)}.ds-btn:focus-visible{outline:1px solid var(--focus);outline-offset:-1px}.ds-btn-ghost{background:transparent;box-shadow:none;color:var(--fg-2)}.ds-btn-ghost:hover{background:var(--component);color:var(--fg)}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Borderless field on the hairline shadow; focus ring stacks on it.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"M10.5 10.5L14 14\"/></svg><input placeholder=\"Search mints\"></label>",
      "css": ".ds-search{position:relative;display:flex;align-items:center;height:40px;width:280px;border-radius:8px;background-color:var(--surface-strong);background-image:var(--sheen-well);box-shadow:var(--s-well);transition:background-color 150ms var(--ease),box-shadow 150ms var(--ease)}.ds-search:hover{background-color:var(--surface-strong-hover)}.ds-search:focus-within{box-shadow:var(--focus-ring),var(--s-well)}.ds-search svg{position:absolute;left:12px;width:16px;height:16px;color:var(--fg-3)}.ds-search input{width:100%;height:100%;padding:0 8px 0 36px;border:0;background:transparent;color:var(--fg);font:inherit;font-size:13px;line-height:20px;outline:none}"
    },
    {
      "name": "Segmented Nav",
      "kind": "nav",
      "refersTo": "nav-tab",
      "description": "Interfere tabs: grey track, the current page a raised pill with a 1px gray edge.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-tab\" aria-current=\"page\">Mints</a><a class=\"ds-tab\">Auditors</a><a class=\"ds-tab\">Analytics</a><a class=\"ds-tab\">Donate</a></nav>",
      "css": ".ds-nav{display:inline-flex;border-radius:6px;background:var(--component)}.ds-tab{display:inline-flex;align-items:center;height:28px;padding:0 10px;border-radius:6px;color:var(--fg-2);font-family:var(--font-sans);font-size:13px;line-height:20px;font-weight:500;cursor:pointer;transition:color 200ms ease-in-out,background-color 200ms ease-in-out}.ds-tab:hover{color:var(--fg)}.ds-tab[aria-current='page']{color:var(--fg);background:var(--surface-strong);box-shadow:inset 0 0 0 1px var(--tab-border)}"
    },
    {
      "name": "State Badges",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Interfere md badges for mint state and error categories.",
      "html": "<span class=\"ds-badge ds-ok\">Online</span> <span class=\"ds-badge ds-warn\">Degraded</span> <span class=\"ds-badge ds-err\">Offline</span> <span class=\"ds-badge ds-info\">config</span> <span class=\"ds-badge\">Unknown</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;height:20px;padding:0 6px;border-radius:4px;background:var(--component);color:var(--fg-2);font-family:var(--font-sans);font-size:12px;line-height:16px}.ds-ok{background:var(--success-bg);color:var(--success-fg)}.ds-warn{background:var(--warning-bg);color:var(--warning-fg)}.ds-err{background:var(--danger-bg);color:var(--danger-fg)}.ds-info{background:var(--brand-subtle);color:var(--on-brand-subtle)}"
    },
    {
      "name": "Hallmarks",
      "kind": "custom",
      "refersTo": "hallmark",
      "description": "The signature: one TX-02 stamp per auditor. Struck, partial, voided, outline.",
      "html": "<span class=\"ds-hallmarks\"><span class=\"ds-hm ds-struck\">A1</span><span class=\"ds-hm ds-partial\">B2</span><span class=\"ds-hm ds-voided\">C3</span><span class=\"ds-hm\">D4</span></span>",
      "css": ".ds-hallmarks{display:inline-flex;gap:4px}.ds-hm{display:inline-flex;align-items:center;justify-content:center;min-width:28px;height:20px;padding:0 6px;border-radius:4px;box-shadow:inset 0 0 0 1px var(--border);color:var(--fg-2);font-family:var(--font-mono);font-feature-settings:'ss02';font-variant-numeric:tabular-nums;font-size:12px;line-height:16px;font-weight:700}.ds-struck{background:var(--inverted);box-shadow:none;color:var(--on-inverted)}.ds-partial{background:var(--warning-bg);box-shadow:none;color:var(--warning-fg)}.ds-voided{background:var(--danger-bg);box-shadow:none;color:var(--danger-fg);text-decoration:line-through}"
    },
    {
      "name": "Directory Row",
      "kind": "custom",
      "refersTo": "mint-row",
      "description": "Ledger row on the page: avatar (mint icon or initial), name over a copy-URL button, state badge; the name's link is stretched over the row; 0.5px rules; hover tint bleeds past the column.",
      "html": "<ul class=\"ds-list\"><li><div class=\"ds-row\"><span class=\"ds-av\">E</span><span class=\"ds-id\"><b>Example Mint</b><button class=\"ds-url\">mint.example.com<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"1.5\"/><path d=\"M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5\"/></svg></button></span><span class=\"ds-badge ds-ok\">Healthy</span></div></li><li><div class=\"ds-row\"><span class=\"ds-av\">S</span><span class=\"ds-id\"><b>Second Mint</b><button class=\"ds-url\">ecash.example.org<svg viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"5.5\" y=\"5.5\" width=\"8\" height=\"8\" rx=\"1.5\"/><path d=\"M10.5 5.5V4A1.5 1.5 0 0 0 9 2.5H4A1.5 1.5 0 0 0 2.5 4v5A1.5 1.5 0 0 0 4 10.5h1.5\"/></svg></button></span><span class=\"ds-badge\">Not checked yet</span></div></li></ul>",
      "css": ".ds-badge{display:inline-flex;align-items:center;height:20px;padding:0 6px;border-radius:4px;background:var(--component);color:var(--fg-2);font-family:var(--font-sans);font-size:12px;line-height:16px}.ds-ok{background:var(--success-bg);color:var(--success-fg)}.ds-list{margin:0;padding:0 12px;list-style:none;width:520px}.ds-list li{border-top:0.5px solid var(--border)}.ds-list li:last-child{border-bottom:0.5px solid var(--border)}.ds-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:0 12px;margin-inline:-12px;padding:10px 12px;border-radius:8px;color:var(--fg);cursor:pointer;transition:background-color 150ms var(--ease)}.ds-row:hover{background:var(--component)}.ds-av{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;background:var(--component);box-shadow:inset 0 0 0 0.5px var(--border-strong);color:var(--fg-2);font-size:14px;font-weight:600}.ds-id{display:flex;flex-direction:column;align-items:flex-start}.ds-id b{font-weight:500}.ds-url{display:inline-flex;align-items:center;gap:6px;height:24px;margin:0 -6px;padding:0 6px;border:0;border-radius:6px;background:transparent;color:var(--fg-2);font-family:var(--font-mono);font-feature-settings:'ss02';font-size:13px;line-height:20px;cursor:pointer}.ds-url:hover{background:var(--component-hover);color:var(--fg)}.ds-url svg{width:14px;height:14px;color:var(--fg-3)}"
    },
