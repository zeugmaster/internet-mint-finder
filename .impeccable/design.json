    },
    "rootCss": ":host{--bg:#f3f2ee;--surface:#ffffff;--subtle:#e9e7e1;--ink:#141413;--muted:#5c5a55;--faint:#68655e;--rule:#ecebe6;--ok:#2b7a3d;--warn:#8a5a00;--error:#b9330c;--info:#2f5f9e;--font:'TX-02',ui-monospace,'SF Mono',Menlo,monospace;--radius-control:8px;--radius-surface:16px;--ease:150ms ease;font-family:var(--font);font-size:15px;line-height:1.5;font-variant-numeric:tabular-nums;color:var(--ink)} "
  },
  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Inverted ink; the one main action per view.",
      "html": "<button class=\"ds-btn ds-btn-primary\">Donate ecash</button>",
      "css": ".ds-btn{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:0;border-radius:var(--radius-control,8px);font-size:15px;cursor:pointer;white-space:nowrap;transition:background-color 150ms ease,color 150ms ease,opacity 150ms ease}.ds-btn-primary{background:var(--ink,#141413);color:var(--surface,#fff);font-weight:700}.ds-btn-primary:hover{opacity:.85}.ds-btn-primary:active{opacity:.75}.ds-btn:focus-visible{outline:2px solid var(--ink,#141413);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Tray-grey default button for every other action.",
      "html": "<button class=\"ds-btn2\">Analytics</button>",
      "css": ".ds-btn2{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:inline-flex;align-items:center;gap:8px;padding:10px 18px;border:0;border-radius:var(--radius-control,8px);background:var(--subtle,#e9e7e1);color:var(--ink,#141413);font-size:15px;cursor:pointer;transition:background-color 150ms ease}.ds-btn2:hover{background:color-mix(in oklab,var(--subtle,#e9e7e1),var(--ink,#141413) 8%)}.ds-btn2:focus-visible{outline:2px solid var(--ink,#141413);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Quiet muted action that gains the tray on hover.",
      "html": "<button class=\"ds-btn-ghost\"><svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M13 8H3.5M7.5 4L3.5 8l4 4\"/></svg>Previous</button>",
      "css": ".ds-btn-ghost{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border:0;border-radius:var(--radius-control,8px);background:transparent;color:var(--muted,#5c5a55);font-size:13px;cursor:pointer;transition:background-color 150ms ease,color 150ms ease}.ds-btn-ghost:hover{background:var(--subtle,#e9e7e1);color:var(--ink,#141413)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ink,#141413);outline-offset:2px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Recessed paper field inside a sheet, ink outline on focus.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"/><path d=\"M10.5 10.5L14 14\"/></svg><input placeholder=\"Find a mint…\" aria-label=\"Find a mint\"></label>",
      "css": ".ds-search{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:flex;align-items:center;gap:10px;padding:0 14px;border-radius:var(--radius-control,8px);background:var(--bg,#f3f2ee);color:var(--faint,#68655e)}.ds-search:focus-within{outline:2px solid var(--ink,#141413)}.ds-search input{flex:1;min-width:0;padding:10px 0;border:0;background:transparent;color:var(--ink,#141413);font:inherit;font-size:15px;outline:none}.ds-search input::placeholder{color:var(--faint,#68655e)}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "refersTo": "nav-link",
      "description": "Flat text links; the current page sits on the tray.",
      "html": "<nav class=\"ds-nav\"><a href=\"#\" aria-current=\"page\">Directory</a><a href=\"#\">Donate</a><a href=\"#\">Auditors</a><a href=\"#\">Analytics</a></nav>",
      "css": ".ds-nav{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:flex;gap:4px;font-size:15px}.ds-nav a{padding:7px 12px;border-radius:var(--radius-control,8px);color:var(--muted,#5c5a55);text-decoration:none;transition:color 150ms ease,background-color 150ms ease}.ds-nav a:hover{color:var(--ink,#141413)}.ds-nav a[aria-current=page]{background:var(--subtle,#e9e7e1);color:var(--ink,#141413)}.ds-nav a:focus-visible{outline:2px solid var(--ink,#141413);outline-offset:2px}"
    },
    {
      "name": "Status and Category Chips",
      "kind": "chip",
      "refersTo": "category-chip",
      "description": "Dot-and-word health badge; tray chip coloured by error class.",
      "html": "<span class=\"ds-badge ds-ok\"><i></i>Healthy</span> <span class=\"ds-badge ds-warn\"><i></i>Degraded</span> <span class=\"ds-cat ds-cat-err\">network</span> <span class=\"ds-cat ds-cat-info\">liquidity</span>",
      "css": ".ds-badge{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:inline-flex;align-items:center;gap:7px;font-size:15px;color:var(--muted,#5c5a55)}.ds-badge i{width:7px;height:7px;border-radius:50%;background:currentColor}.ds-ok{color:var(--ok,#2b7a3d)}.ds-warn{color:var(--warn,#8a5a00)}.ds-cat{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);display:inline-flex;padding:2px 8px;border-radius:6px;background:var(--subtle,#e9e7e1);color:var(--muted,#5c5a55);font-size:12px}.ds-cat-err{color:var(--error,#b9330c)}.ds-cat-info{color:var(--info,#2f5f9e)}"
    },
    {
      "name": "Stat Surface",
      "kind": "card",
      "refersTo": "card",
      "description": "Flat sheet at 16px radius holding one figure.",
      "html": "<div class=\"ds-kpi\"><div class=\"ds-kpi-l\">Volume audited</div><div class=\"ds-kpi-v\">7038<span>sat</span></div><div class=\"ds-kpi-s\">+7038 sat / 24h</div></div>",
      "css": ".ds-kpi{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);padding:18px 20px;border-radius:var(--radius-surface,16px);background:var(--surface,#fff);font-size:15px;line-height:1.5;font-variant-numeric:tabular-nums;max-width:280px}.ds-kpi-l{color:var(--muted,#5c5a55)}.ds-kpi-v{margin-top:2px;font-size:24px;font-weight:700;letter-spacing:-.02em;color:var(--ink,#141413)}.ds-kpi-v span{margin-left:6px;font-size:15px;font-weight:400;color:var(--muted,#5c5a55)}.ds-kpi-s{font-size:13px;color:var(--faint,#68655e)}"
    },
    {
      "name": "Hallmarks",
      "kind": "custom",
      "refersTo": "hallmark-struck",
      "description": "Signature: one stamp per auditor, struck, partial, voided or no verdict, each naming its auditor on hover and focus.",
      "html": "<span class=\"ds-hm-row\"><button class=\"ds-hm ds-struck\" data-tip=\"Auditor 3f3f…: settled 2m ago\">3f</button><button class=\"ds-hm ds-partial\" data-tip=\"Auditor a9a9…: settled after a failure 4m ago\">a9</button><button class=\"ds-hm ds-voided\" data-tip=\"This instance: failed 1m ago\">loc</button><button class=\"ds-hm\" data-tip=\"Auditor 7c7c…: no verdict\">7c</button></span>",
      "css": ".ds-hm-row{display:inline-flex;gap:5px;padding-top:36px}.ds-hm{font-family:var(--font, 'TX-02', ui-monospace, Menlo, monospace);position:relative;display:inline-grid;place-items:center;min-width:28px;height:21px;padding:0 5px;border:0;border-radius:5px;background:transparent;font-size:11px;font-weight:700;line-height:1;color:var(--faint,#68655e);box-shadow:inset 0 0 0 1px var(--subtle,#e9e7e1);cursor:help}.ds-struck{background:var(--ink,#141413);color:var(--surface,#fff);box-shadow:none}.ds-partial{color:var(--warn,#8a5a00);box-shadow:inset 0 0 0 1.5px var(--warn,#8a5a00)}.ds-voided{color:var(--error,#b9330c);box-shadow:inset 0 0 0 1.5px var(--error,#b9330c);text-decoration:line-through}.ds-hm::after{content:attr(data-tip);position:absolute;bottom:calc(100% + 6px);left:50%;padding:6px 10px;border-radius:6px;background:var(--ink,#141413);color:var(--surface,#fff);font-size:12px;font-weight:400;text-decoration:none;white-space:nowrap;pointer-events:none;opacity:0;transform:translateX(-50%);transition:opacity 150ms ease}.ds-hm:hover::after,.ds-hm:focus-visible::after{opacity:1}.ds-hm:focus-visible{outline:2px solid var(--ink,#141413);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Assay Register",
    "overview": "A flat, quiet ledger in one monospaced voice. Every surface is a tonal sheet laid on a warm paper ground; nothing glows, floats or gradates. The page reads like a register an assay office keeps: names, figures and outcomes in rows, and beside each mint a short line of hallmarks, one stamp struck by each independent auditor. The stamps are the only ornament, and they carry evidence.\n\nThe system ships in light and dark with the same structure and equal standing; the theme follows the visitor's setting before first paint and a footer toggle overrides it. Density is calm-operational: 15px base text, 16px gutters, generous card padding (20px 24px), tables with hairline row rules. Colour is withheld from chrome entirely; ink, three greys and tonal steps do all the hierarchy work, and hue appears only where the system is reporting health.\n\nThe world refuses the crypto-dashboard default: glowing dark panels, gradient KPIs, glass, and a single merged score.",
    "keyCharacteristics": [
      "One typeface (TX-02) for every role, tabular figures throughout.",
      "Warm neutral ramps, mirrored for light and dark.",
      "Tonal layering instead of borders or shadows: page, sheet, tray.",
      "Inverted-ink primary action; everything else is tray-grey or ghost.",
      "Colour only for health: ok, warn, error, plus info for neutral error categories.",
      "Per-auditor hallmark stamps as the signature."
    ],
    "rules": [
      {
        "name": "The Health-Only Rule",
        "body": "Hue appears only when the system reports a health state or an error category. Navigation, buttons, headings and surfaces stay ink and grey.",
        "section": "colors"
      },
      {
        "name": "The Tint, Not Fill Rule",
        "body": "Health-tinted surfaces (incident panel, error callout, donation acknowledgement) are the signal colour mixed 10 to 12% into the sheet, never a saturated block.",
        "section": "colors"
      },
      {
        "name": "The Paper QR Rule",
        "body": "The donation QR always sits on a pure white frame (#ffffff, 12px radius, 14px padding) in both themes so scanners read it.",
        "section": "colors"
      },
      {
        "name": "The One Voice Rule",
        "body": "TX-02 sets every string, headings included. Tabular numerals are on globally so figures align in columns and while values refresh.",
        "section": "typography"
      },
      {
        "name": "The Sentence Case Rule",
        "body": "No uppercase labels and no wide tracking; letter-spacing only tightens (-0.01em to -0.02em) on bold sizes.",
        "section": "typography"
      },
      {
        "name": "The Tonal Stack Rule",
        "body": "Ground, sheet, tray, recess. A new layer is a new tone from this stack, never a shadow or an outline.",
        "section": "elevation"
      },
      {
        "name": "The Inset Ring Exception",
        "body": "The only box-shadow in the system is the 1 to 1.5px inset ring that outlines an idle, partial or voided hallmark. It draws the stamp's edge; it is not elevation and must not spread to other components.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every string in TX-02 with tabular numerals.",
      "Do build depth from the tonal stack: paper ground, sheet at 16px radius, tray controls at 8px, recessed paper inputs.",
      "Do reserve the inverted-ink fill for the one primary action and the struck hallmark.",
      "Do use hue only for health states and error categories, and tint health surfaces at 10 to 12% into the sheet.",
      "Do ship every change in both light and dark, using the token pairs.",
      "Do show each auditor's own stamp; add a stamp key wherever auditors are listed.",
      "Do keep motion to 150ms colour and opacity transitions, and none under reduced motion."
    ],
    "donts": [
      "Don't add drop shadows, gradients, glass or blur to any surface; the hallmark's inset ring is the only shadow in the system.",
      "Don't outline cards or controls with borders; hairline rules belong only between rows inside a surface.",
      "Don't colour navigation, headings, buttons or surfaces with a brand hue.",
      "Don't merge auditor stamps into one score or badge.",
      "Don't introduce a second typeface, uppercase labels or wide letter-spacing."
    ]
  }
}