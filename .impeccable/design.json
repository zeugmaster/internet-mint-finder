      },
      {
        "name": "breathe",
        "value": "opacity 1 to 0.5, 1.4s ease-in-out infinite",
        "purpose": "Loading skeletons."
      },
      {
        "name": "reduced-motion",
        "value": "animation and transition none",
        "purpose": "Applied globally under prefers-reduced-motion: reduce."
      }
