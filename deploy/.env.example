# ---- Identity (generate with: docker compose run --rm imf keygen) ----------
# Private BIP-39 seed of this instance's wallet. Never share, never reuse.
CDK_MNEMONIC=""
# This auditor's Nostr key. Peers list the matching npub in IMF_AUDITORS.
IMF_NOSTR_NSEC=""
# Every auditor whose observations this instance shows (npub or hex, comma
# separated). Include your own; it is ignored for ingest.
IMF_AUDITORS=""

# ---- Names ----------------------------------------------------------------
APP_NAME="Internet Mint Finder"
# Shared apex (points at every instance) and this instance's own name.
IMF_DOMAIN=imf.example
IMF_HOSTNAME=a.imf.example
RELAY_HOSTNAME=relay-a.imf.example
# NUT-18 transports and announcements use the instance name, never the apex.
BASE_URL=https://a.imf.example
# URLs announced on Nostr for this instance (clearnet, onion).
IMF_PUBLIC_URLS=https://a.imf.example
# Fill in after the first start: docker compose exec tor cat /var/lib/tor/imf/hostname
ONION_HOSTNAME=
# Optional, pseudonymous.
IMF_CONTACT=

# ---- Relays ---------------------------------------------------------------
# Own archive relay first, then public ones.
# The first relay is the required archive; public relay ACKs do not clear the outbox.
IMF_RELAYS=ws://strfry:7777,wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net,wss://relay.cashumints.space

# ---- TLS ------------------------------------------------------------------
# Bunny DNS API key (account-wide) for the DNS-01 challenge.
BUNNY_API_KEY=
# Pseudonymous mailbox for Let's Encrypt expiry notices.
ACME_EMAIL=

# ---- Audit engine (see ../README.md for the full table) ---------------------
# AUDITOR_MIN_DELAY_SECS=300
# AUDITOR_MAX_DELAY_SECS=900
RUST_LOG=info
